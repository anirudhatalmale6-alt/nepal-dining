# team.json is fetched by the website itself, so it must stay publicly readable.
# It only ever contains team names and photos — nothing private.
# Browsers must not cache it, or an edit would keep showing the old
# number until the visitor hard-refreshes.
<IfModule mod_headers.c>
    <Files "team.json">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
</IfModule>

# The rollback copy is not for the public.
<Files "team.json.bak">
    Order Allow,Deny
    Deny from all
</Files>
